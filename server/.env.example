# ============================================================
# AI FITNESS COACH — SERVER ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.

# ─── App ────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5174

# ─── MongoDB ────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ai-fitness-coach?retryWrites=true&w=majority

# ─── JWT ────────────────────────────────────────────────────
# Access token (short-lived, default 15m)
JWT_SECRET=replace_with_a_very_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=15m
# Refresh token (long-lived, default 30d)
JWT_REFRESH_SECRET=replace_with_another_very_long_random_secret_string
JWT_REFRESH_EXPIRES_IN=30d

# ─── Cloudinary ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── OpenRouter (AI) ────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ─── Gemini AI ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest

# ─── YouTube Data API ───────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_api_key

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs

# ─── Admin Bootstrap ────────────────────────────────────────
# Used by src/scripts/seedAdmin.js to create the initial admin user.
# Run `node src/scripts/seedAdmin.js` after setting these.
ADMIN_EMAIL=
ADMIN_PASSWORD=
