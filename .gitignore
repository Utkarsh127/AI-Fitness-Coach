# ============================================================
# AI Fitness Coach — Root Git Ignore
# ============================================================

# ─── Dependencies ───────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Production Builds & Bundles ────────────────────────────
dist/
build/
.next/
out/

# ─── Test Coverage & Reports ────────────────────────────────
coverage/
.nyc_output/

# ─── Logs & Runtime Diagnostics ─────────────────────────────
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Environment Variables (Keep secrets local, preserve examples) ─
.env
.env.*
.env.local
.env.*.local
!.env.example
!**/.env.example

# ─── Server Uploads ─────────────────────────────────────────
uploads/
**/uploads/

# ─── Operating System & Editor Files ────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj

